# BerylBytes POS - Environment Variables

# ==========================================
# IMPORTANT: DO NOT COMMIT REAL .env FILES!
# ==========================================
# This is a template. Copy this to a file named `.env` and fill in the values.
# The frontend uses Vite, so variables must be prefixed with VITE_ to be exposed.

# API Base URL (Backend Server)
VITE_API_URL=http://localhost:5000/api/v1

# Authentication / Security
VITE_JWT_SECRET=replace_this_with_a_long_random_string_for_local_dev
VITE_SESSION_TIMEOUT_MINUTES=30

# Third-Party Integrations (Mocks in Dev)
VITE_STRIPE_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
VITE_MPESA_TILL_NUMBER=123456

# Feature Flags
VITE_ENABLE_PASSKEYS=true
VITE_ENABLE_PHARMACY_MODULE=true
